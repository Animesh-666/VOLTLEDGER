# Template only. This project does not automatically load .env files.
# No real credentials may be stored here.
# Local no-database mode:
SPRING_PROFILES_ACTIVE=preview

# Local Firebase mode (set these privately in the PowerShell session):
# SPRING_PROFILES_ACTIVE=firebase
# FIREBASE_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=C:\\outside-repository\\firebase-service-account.json
# VL_BOOTSTRAP_ADMIN_USERNAME=admin
# VL_BOOTSTRAP_ADMIN_PASSWORD=never-put-real-passwords-in-this-file

# Render production mode:
# SPRING_PROFILES_ACTIVE=firebase,production
# FIREBASE_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
# VL_PUBLIC_REGISTRATION_ENABLED=false
# VL_BOOTSTRAP_ADMIN_PASSWORD=(configure privately in Render only if no admin exists)
